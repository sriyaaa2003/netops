server {
    listen 80;
    server_name _;

    client_max_body_size 4m;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve upstream service names at request time, not once at startup,
    # so a DNS hiccup during pod boot (e.g. CoreDNS still starting) doesn't
    # crash-loop this container. NGINX_LOCAL_RESOLVERS is populated by the
    # official nginx image's entrypoint from /etc/resolv.conf when
    # NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 is set (see Dockerfile).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=5s;

    # Fully-qualified names: nginx's resolver does not apply the
    # /etc/resolv.conf search-domain expansion that short names rely on.
    set $log_service log-service.netops.svc.cluster.local;
    set $anomaly_service anomaly-service.netops.svc.cluster.local;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Because proxy_pass uses a variable, nginx sends exactly the URI written
    # here and does not append the rest of the request, so the query string
    # ($is_args$args, for ?limit= and ?detector=) is added by hand and the
    # /api/logs/:id part is captured by the regex.
    location ~ ^/api/logs(?<rest>/.*)?$ {
        proxy_pass http://$log_service:4000/logs$rest$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-API-Key ${API_KEY};
    }

    location /api/analyze {
        proxy_pass http://$anomaly_service:5001/analyze$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-API-Key ${API_KEY};
    }

    location /api/anomalies {
        proxy_pass http://$anomaly_service:5001/anomalies$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-API-Key ${API_KEY};
    }
}
